# Never commit a real Neon password or connection string.
# Use the pooled Neon URL for normal Render application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DBNAME?sslmode=require

# Use the direct Neon URL for Alembic DDL and one-time data migration.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DBNAME?sslmode=require

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10

# Optional dedicated encryption secret for durable cTrader OAuth tokens.
# Generate a long random value and keep it stable across deployments.
# When omitted, FlowSignal derives the encryption key from CTRADER_CLIENT_SECRET.
CTRADER_TOKEN_ENCRYPTION_KEY=

# Email app password used by feedback/signal email delivery. Never commit a
# real value; configure it in Render and rotate any previously committed value.
FEEDBACK_APP_PASSWORD=

# Economic-calendar providers. JBlanked MQL5 is authoritative for historical
# preflight/backfill. Provider plan access must be verified with real keys.
JBLANKED_API_KEY=
JBLANKED_NEWS_BASE_URL=https://www.jblanked.com/news/api
FMP_API_KEY=
FMP_NEWS_BASE_URL=https://financialmodelingprep.com/stable/economic-calendar
FINNHUB_API_KEY=
